<mxfile host="Electron">
  <diagram id="citus-arch" name="Citus Cluster">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="bazaar Citus Cluster — Coordinator + 2 Workers" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="psql / app&#xa;psql -h localhost -p 5432 -U postgres -d bazaar" style="shape=actor;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="70" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="coord" value="COORDINATOR&#xa;bazaar-coordinator&#xa;localhost:5432&#xa;&#xa;• cluster metadata (pg_dist_*)&#xa;• distributed query planner&#xa;• merges worker results&#xa;• local tables live here" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1">
