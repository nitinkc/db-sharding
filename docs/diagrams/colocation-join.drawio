<mxfile host="Electron">
  <diagram id="colocation" name="Co-located Join">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Co-location — same fleet bucket lives together on one worker" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="640" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="meta" value="colocation_id = 3&#xa;fleets ⋈ vehicles ⋈ trips&#xa;all distributed BY fleet_id,&#xa;same shard count, same placements" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="WORKER 1 — owns hash bucket containing fleet_id = 1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="400" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="w1a" value="fleets_102016&#xa;fleet 1 row" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;size=13;" vertex="1" parent="1">
          <mxGeometry x="130" y="330" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w1b" value="vehicles_102032&#xa;fleet 1's vehicles" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w1c" value="trips_102048&#xa;fleet 1's trips" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=13;" vertex="1" parent="1">
          <mxGeometry x="225" y="430" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w1j" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;startArrow=none;strokeWidth=3;strokeColor=#2f5b26;" edge="1" parent="1" source="w1a" target="w1b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w1join" value="local join&#xa;ON fleet_id&#xa;— zero network" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2f5b26;" vertex="1" parent="1">
          <mxGeometry x="230" y="370" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="WORKER 2 — bucket containing fleet_id = 2" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="260" width="400" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="w2a" value="fleets_102017&#xa;fleet 2 row" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;size=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w2b" value="vehicles_102033&#xa;fleet 2's vehicles" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="840" y="330" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w2c" value="trips_102049&#xa;fleet 2's trips" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="430" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w2j" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;startArrow=none;strokeWidth=3;strokeColor=#2f5b26;" edge="1" parent="1" source="w2a" target="w2b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="plan" value="EXPLAIN result (Lab 6 Task 6):&#xa;Task Count: 1&#xa;  Node: worker1&#xa;    Nested Loop&#xa;      -&gt; fleets_102016  (fleet_id=1)&#xa;      -&gt; vehicles_102032 (fleet_id=1)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1f1f1f;fontColor=#d4d4d4;strokeColor=#444444;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="520" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="point" value="Whole join runs INSIDE one task on one worker.&#xa;No data movement, no coordinator merge.&#xa;That's what colocation buys." style="text;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="620" width="400" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
