<mxfile host="Electron">
  <diagram id="range-vs-hash" name="Range vs Hash Time Series">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="order_events — range partitions vs hash shards" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="600" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="stream" value="20,000 new events&#xa;event_time = now&#xa;(one every 2 s)" style="shape=cloud;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="Lp" value="RANGE placement" style="text;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="p_2026_03_01&#xa;[03-01, 03-02)&#xa;1,000 rows&#xa;COLD" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;size=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="p_2026_03_02&#xa;[03-02, 03-03)&#xa;1,000 rows&#xa;COLD" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;size=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="p_2026_03_03&#xa;[03-03, MAXVALUE)&#xa;20,000 rows&#xa;HOT — all writes" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="le" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#b85450;label=all inserts" edge="1" parent="1" source="stream" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Hp" value="HASH placement (same data)" style="text;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="hs1" value="shard 1&#xa;~2,750 rows&#xa;all days mixed" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="530" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hs2" value="shard 2&#xa;~2,750" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="530" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hs3" value="… shard 8&#xa;~2,750" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="he" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;label=balanced writes" edge="1" parent="1" source="stream" target="hs2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cmp" value="One-day read WHERE event_time &gt;= '03-01' AND &lt; '03-02':&#xa;&#xa;RANGE → scans 1 partition (partition pruning)&#xa;HASH  → fans out to all 8 shards&#xa;&#xa;Trade-off: range optimizes windowed READS,&#xa;concentrates WRITES on 'now'. Hash is the mirror." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="220" width="330" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
