<mxfile host="Electron">
  <diagram id="query-routing" name="Query Routing">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="L" value="GOOD: WHERE on shard key → ROUTER plan (Task Count: 1)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#2f5b26;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="560" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="R" value="BAD: WHERE off shard key → FAN-OUT (Task Count: 8)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="540" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="lq" value="SELECT * FROM vehicles&#xa;WHERE fleet_id = 1&#xa;&#xa;vehicles sharded BY fleet_id" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lc" value="COORDINATOR&#xa;hash(1) → shard …032 → worker1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lt" value="TASK 1 of 1&#xa;SELECT … FROM vehicles_102032" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;size=14;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="le" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#2f5b26;label=ONE task" edge="1" parent="1" source="lc" target="lt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="lq" target="lc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rq" value="SELECT * FROM vehicles&#xa;WHERE fleet_id = 1&#xa;&#xa;vehicles sharded BY vehicle_id" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rc" value="COORDINATOR&#xa;can't route — fleet_id isn't the key" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="rt1" value="task→shard1" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt2" value="task→shard2" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt3" value="task→shard3" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt4" value="task→shard4" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="160" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt5" value="task→shard5" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="240" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt6" value="task→shard6" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="240" width="80" height= "44" as="geometry"/>
        </mxCell>
        <mxCell id="rt7" value="task→shard7" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="320" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rt8" value="task→shard8" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;size=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="320" width="80" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="re0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="rq" target="rc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="rc" target="rt1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="rc" target="rt2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="rc" target="rt5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="rc" target="rt8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dots" value="… all 8 shards&#xa;queried in parallel,&#xa;merged on coordinator" style="text;html=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="990" y="400" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Same SQL, different shard key ⇒ Task Count 1 vs 8.&#xa;Read 'Task Count' in EXPLAIN (COSTS OFF) — it's the shard-key report card." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="500" width="750" height="55" as="geometry"/>
