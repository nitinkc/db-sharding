        </mxCell>
        <mxCell id="sC" value="shard …018&#xa;ids: 4, 7" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;size=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="240" width="110" height="60" as="geometry"/>
