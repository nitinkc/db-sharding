          <mxGeometry x="620" y="240" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sE" value="shard …017&#xa;id: 5" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;size=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sF" value="shard …021&#xa;id: 6" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;size=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sG" value="shard …022&#xa;id: 2" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;size=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="110" height="60" as="geometry"/>
