        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="ids" target="hash"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hash" target="sA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hash" target="sE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Lab 6 Task 2 findings:&#xa;• consecutive ids land on DIFFERENT shards — mapping looks random&#xa;• re-running gives IDENTICAL results — hashing is deterministic&#xa;• same value always → same shard (that's what makes routing computable)&#xa;• monotonic keys spread evenly — no write hotspot" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="200" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="sql" value="SELECT id, get_shard_id_for_distribution_column('sellers', id)&#xa;FROM generate_series(1,8) id;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1f1f1f;fontColor=#d4d4d4;strokeColor=#444444;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="390" width="340" height="60" as="geometry"/>
        </mxCell>
