<mxfile host="Electron"><diagram id="storage" name="Table storage"><mxGraphModel grid="1" pageWidth="1000" pageHeight="600" background="#ffffff"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Lab 2 · Three ways a table can be stored" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="920" height="45" as="geometry"/></mxCell>
<mxCell id="local" value="LOCAL TABLE&lt;br&gt;&lt;br&gt;Coordinator&lt;br&gt;[ A · B · C · D ]&lt;br&gt;&lt;br&gt;Workers 1–3: no rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontColor=#16324f;fontSize=17;spacing=16;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="distributed" value="DISTRIBUTED TABLE&lt;br&gt;&lt;br&gt;Coordinator routes SQL&lt;br&gt;&lt;br&gt;Worker 1: [ A ]&lt;br&gt;Worker 2: [ B ]&lt;br&gt;Worker 3: [ C ]&lt;br&gt;&lt;br&gt;Disjoint slices of the rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontColor=#16324f;fontSize=17;spacing=16;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="reference" value="REFERENCE TABLE&lt;br&gt;&lt;br&gt;Coordinator routes SQL&lt;br&gt;&lt;br&gt;Workers 1–3:&#xa;[ A · B · C · D ] each&lt;br&gt;&lt;br&gt;Full copy on each worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontColor=#16324f;fontSize=17;spacing=16;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="280" height="230" as="geometry"/></mxCell>
<mxCell id="evidence" value="Collect evidence, not guesses&lt;br&gt;citus_tables → managed type · citus_shards → shard locations · count(*) → logical row count&lt;br&gt;&lt;br&gt;A–D are illustrative rows. A query through the coordinator alone does not reveal storage type." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#90a4ae;fontColor=#16324f;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="900" height="125" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
